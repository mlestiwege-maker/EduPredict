# Backend Environment Variables
# Copy this to .env for local development or set in your hosting platform (Railway/Render/Fly)

# Application
APP_NAME=EduPredict
VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://edupredict:edupredict123@localhost:5432/edupredict

# Security
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# CORS (set to your Vercel frontend URL in production)
CORS_ORIGINS=http://localhost:3000,https://edupredict.vercel.app

# File upload
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls

# Machine Learning
MODEL_PATH=./ml/models
PREDICTION_BATCH_SIZE=1000

# Static files
STATIC_DIR=./static

# Email (future use)
SMTP_HOST=localhost
SMTP_PORT=587
